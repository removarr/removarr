# The build context lists what it may use (spec section 11). Everything else, in particular
# .env, stays out of every build stage.
*
!cmd/
!internal/
!web/
!go.mod
!go.sum
internal/webui/dist/*
!internal/webui/dist/.gitkeep
web/node_modules/
web/test-results/
web/playwright-report/
**/.env
**/.env.*
**/*.db
**/*.db-wal
**/*.db-shm
